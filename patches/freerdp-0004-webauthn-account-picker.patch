+static bool sdl_fido_dialog(freerdp* instance, const char* const* labels, size_t count,
+                            bool pin, std::vector<char>& response, const char* site,
+                            const char* retries)
+{
+	if (!instance || !instance->context || (!pin && (!labels || count < 2 || count > 128)))
+		return false;
+
+	std::shared_ptr<FidoKeyboardGrab> keyboard;
+	try
+	{
+		keyboard = std::make_shared<FidoKeyboardGrab>();
+	}
+	catch (...)
+	{
+		return false;
+	}
+	if (!sdl_fido_release_keyboard(instance->context, keyboard))
+		return false;
+	struct RestoreKeyboard
+	{
+		std::shared_ptr<FidoKeyboardGrab> state;
+		~RestoreKeyboard() { sdl_fido_restore_keyboard(state); }
+	} restore{ keyboard };
+
+	int sockets[2];
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0)
+		return FALSE;
+
+	posix_spawn_file_actions_t actions;
+	if (posix_spawn_file_actions_init(&actions) != 0)
+	{
+		close(sockets[0]);
+		close(sockets[1]);
+		return FALSE;
+	}
+	const int actionError = posix_spawn_file_actions_adddup2(&actions, sockets[1], STDIN_FILENO) ||
+	                        posix_spawn_file_actions_adddup2(&actions, sockets[1], STDOUT_FILENO) ||
+	                        posix_spawn_file_actions_addclose(&actions, sockets[0]) ||
+	                        posix_spawn_file_actions_addclose(&actions, sockets[1]);
+	if (actionError)
+	{
+		posix_spawn_file_actions_destroy(&actions);
+		close(sockets[0]);
+		close(sockets[1]);
+		return FALSE;
+	}
+	std::string python = "python3";
+	std::vector<std::string> args = { python, "/opt/cloud-pc-connect/share/avd-feed-connect/fido-picker.py" };
+	if (pin)
+	{
+		args.emplace_back("--pin");
+		if (sdl_fido_site_valid(site) && (strcmp(site, "-") != 0))
+		{
+			args.emplace_back("--site");
+			args.emplace_back(site);
+		}
+		if (sdl_fido_retries_valid(retries))
+		{
+			args.emplace_back("--retries");
+			args.emplace_back(retries);
+		}
+	}
+	std::vector<char*> argv;
+	for (auto& arg : args)
+		argv.push_back(arg.data());
+	argv.push_back(nullptr);
+	extern char** environ;
+	pid_t child = -1;
+	const int spawned =
+	    posix_spawnp(&child, python.c_str(), &actions, nullptr, argv.data(), environ);
+	posix_spawn_file_actions_destroy(&actions);
+	close(sockets[1]);
+	if (spawned != 0)
+	{
+		close(sockets[0]);
+		return FALSE;
+	}
+
+	auto sendData = [&](const void* data, size_t length) {
+		const auto* bytes = static_cast<const char*>(data);
+		while (length > 0 && !freerdp_shall_disconnect_context(instance->context))
+		{
+			const ssize_t sent = send(sockets[0], bytes, length, MSG_NOSIGNAL | MSG_DONTWAIT);
+			if (sent > 0)
+			{
+				bytes += sent;
+				length -= static_cast<size_t>(sent);
+			}
+			else if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
+			{
+				struct pollfd fd = { sockets[0], POLLOUT, 0 };
+				poll(&fd, 1, 100);
+			}
+			else
+				return false;
+		}
+		return length == 0;
+	};
+	uint32_t value = htonl(static_cast<uint32_t>(count));
+	bool ok = pin || sendData(&value, sizeof(value));
+	for (size_t i = 0; ok && i < count; i++)
+	{
+		const char* label = labels[i] ? labels[i] : "";
+		const size_t length = strlen(label);
+		if (length > 520)
+		{
+			ok = false;
+			break;
+		}
+		value = htonl(static_cast<uint32_t>(length));
+		ok = sendData(&value, sizeof(value)) && sendData(label, length);
+	}
+
+	auto receiveData = [&](void* data, size_t length) {
+		auto* bytes = static_cast<char*>(data);
+		while (length > 0 && !freerdp_shall_disconnect_context(instance->context))
+		{
+			struct pollfd fd = { sockets[0], POLLIN, 0 };
+			const int ready = poll(&fd, 1, 100);
+			if (ready < 0 && errno != EINTR)
+				return false;
+			if (ready <= 0)
+				continue;
+			const ssize_t n = recv(sockets[0], bytes, length, 0);
+			if (n <= 0)
+				return false;
+			bytes += n;
+			length -= static_cast<size_t>(n);
+		}
+		return length == 0;
+	};
+	value = 0;
+	ok = ok && receiveData(&value, sizeof(value));
+	const size_t length = ntohl(value);
+	if (length > 256)
+		ok = false;
+	if (ok && length)
+	{
+		try
+		{
+			response.resize(length);
+			ok = receiveData(response.data(), response.size());
+		}
+		catch (...)
+		{
+			ok = false;
+		}
+	}
+	close(sockets[0]);
+	int status = 0;
+	pid_t waited;
+	do
+	{
+		waited = waitpid(child, &status, WNOHANG);
+	} while (waited < 0 && errno == EINTR);
+	if (waited == 0 && !ok)
+		kill(child, SIGTERM);
+	if (waited == 0)
+	{
+		do
+		{
+			waited = waitpid(child, &status, 0);
+		} while (waited < 0 && errno == EINTR);
+	}
+	return ok && waited == child && WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
+BOOL sdl_choose_fido_credential(freerdp* instance, const char* const* labels, size_t count,
+                                size_t* choice)
+{
+	if (!choice)
+		return FALSE;
+	std::vector<char> response;
+	if (!sdl_fido_dialog(instance, labels, count, false, response) || response.empty())
+		return FALSE;
+	char text[257] = {};
+	memcpy(text, response.data(), response.size());
+	char* end = nullptr;
+	const long selected = strtol(text, &end, 10);
+	if (end == text || !end || *end != '\0' || selected < 0 ||
+	    static_cast<size_t>(selected) >= count)
+		return FALSE;
+	*choice = static_cast<size_t>(selected);
+	return TRUE;
+}
