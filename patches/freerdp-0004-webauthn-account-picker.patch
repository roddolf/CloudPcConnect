+/* Hints passed to the PIN prompt must stay single, harmless arguments. */
+static bool sdl_fido_site_valid(const char* site)
+{
+	if (!site)
+		return false;
+	const size_t length = strnlen(site, 254);
+	if (length == 0 || length > 253)
+		return false;
+	for (size_t i = 0; i < length; i++)
+	{
+		const char c = site[i];
+		if (!(((c >= 'a') && (c <= 'z')) || ((c >= 'A') && (c <= 'Z')) ||
+		      ((c >= '0') && (c <= '9')) || (c == '.') || (c == '-')))
+			return false;
+	}
+	return true;
+}
+
+static bool sdl_fido_retries_valid(const char* retries)
+{
+	if (!retries)
+		return false;
+	if (strcmp(retries, "wrong") == 0)
+		return true;
+	const size_t length = strnlen(retries, 4);
+	if (length == 0 || length > 3)
+		return false;
+	for (size_t i = 0; i < length; i++)
+	{
+		if ((retries[i] < '0') || (retries[i] > '9'))
+			return false;
+	}
+	return true;
+}
+
+struct FidoKeyboardGrab
+{
+	std::atomic<bool> ready{ false };
+	SDL_WindowID window = 0;
+	bool grabbed = false;
+};
+
+static bool sdl_fido_release_keyboard(rdpContext* context,
+                                      const std::shared_ptr<FidoKeyboardGrab>& state)
+{
+	auto holder = std::unique_ptr<std::shared_ptr<FidoKeyboardGrab>>(
+	    new (std::nothrow) std::shared_ptr<FidoKeyboardGrab>(state));
+	if (!holder)
+		return false;
+	if (!SDL_RunOnMainThread(
+	        [](void* data) {
+		        std::unique_ptr<std::shared_ptr<FidoKeyboardGrab>> owned(
+		            static_cast<std::shared_ptr<FidoKeyboardGrab>*>(data));
+		        auto window = SDL_GetKeyboardFocus();
+		        if (window && SDL_GetWindowKeyboardGrab(window))
+		        {
+			        (*owned)->window = SDL_GetWindowID(window);
+			        (*owned)->grabbed = SDL_SetWindowKeyboardGrab(window, false);
+		        }
+		        (*owned)->ready = true;
+	        },
+	        holder.get(), false))
+		return false;
+	holder.release();
+	while (!state->ready)
+	{
+		if (freerdp_shall_disconnect_context(context))
+			return false;
+		Sleep(10);
+	}
+	return true;
+}
+
+static void sdl_fido_restore_keyboard(const std::shared_ptr<FidoKeyboardGrab>& state)
+{
+	if (!state->grabbed)
+		return;
+	auto holder = std::unique_ptr<std::shared_ptr<FidoKeyboardGrab>>(
+	    new (std::nothrow) std::shared_ptr<FidoKeyboardGrab>(state));
+	if (!holder)
+		return;
+	if (SDL_RunOnMainThread(
+	        [](void* data) {
+		        std::unique_ptr<std::shared_ptr<FidoKeyboardGrab>> owned(
+		            static_cast<std::shared_ptr<FidoKeyboardGrab>*>(data));
+		        auto window = SDL_GetWindowFromID((*owned)->window);
+		        if (window && SDL_GetKeyboardFocus() == window)
+			        SDL_SetWindowKeyboardGrab(window, true);
+	        },
+	        holder.get(), false))
+		holder.release();
+}
