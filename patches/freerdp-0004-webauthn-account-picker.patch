+/**
+ * Copy a relying party id that is safe to show and to pass on as a single
+ * argument: a non-empty DNS name of [A-Za-z0-9.-], else "-".
+ */
+static void rdpewa_fido_site(char* dest, size_t size, const char* rpId)
+{
+	WINPR_ASSERT(dest);
+	WINPR_ASSERT(size >= 2);
+
+	const size_t limit = (size - 1 < RDPEWA_FIDO_SITE_MAX) ? size - 1 : RDPEWA_FIDO_SITE_MAX;
+	const size_t length = rpId ? strnlen(rpId, limit + 1) : 0;
+	bool valid = (length > 0) && (length <= limit);
+	for (size_t i = 0; valid && i < length; i++)
+	{
+		const char c = rpId[i];
+		valid = ((c >= 'a') && (c <= 'z')) || ((c >= 'A') && (c <= 'Z')) ||
+		        ((c >= '0') && (c <= '9')) || (c == '.') || (c == '-');
+	}
+
+	if (valid)
+	{
+		memcpy(dest, rpId, length);
+		dest[length] = '\0';
+	}
+	else
+	{
+		dest[0] = '-';
+		dest[1] = '\0';
+	}
+}
