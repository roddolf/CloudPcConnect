+static bool rdpewa_fido_account_label(char* dest, size_t size, const char* value)
+{
+	if (!value || !value[0] || strnlen(value, size) >= size ||
+	    ConvertUtf8ToWChar(value, nullptr, 0) < 0)
+		return false;
+	size_t i = 0;
+	for (; value[i]; i++)
+		dest[i] = ((unsigned char)value[i] < 0x20 || value[i] == 0x7f) ? ' ' : value[i];
+	dest[i] = '\0';
+	return true;
+}
+
+static bool rdpewa_fido_choose_assertion(rdpContext* context, const fido_assert_t* assert,
+                                         size_t* selected)
+{
+	const size_t count = fido_assert_count(assert);
+	if (count == 0 || count > 128 || !selected)
+		return false;
+	*selected = 0;
+	if (count == 1)
+		return true;
+	if (!context || !context->instance || !context->instance->ChooseFidoCredential)
+		return false;
+
+	char** labels = calloc(count, sizeof(*labels));
+	if (!labels)
+		return false;
+	bool ok = false;
+	for (size_t i = 0; i < count; i++)
+	{
+		char name[241] = { 0 };
+		char display[241] = { 0 };
+		const bool hasName = rdpewa_fido_account_label(
+		    name, sizeof(name), fido_assert_user_name(assert, i));
+		const bool hasDisplay = rdpewa_fido_account_label(
+		    display, sizeof(display), fido_assert_user_display_name(assert, i));
+		labels[i] = calloc(1, 520);
+		if (!labels[i])
+			goto out;
+		if (hasName && hasDisplay && strcmp(name, display) != 0)
+			snprintf(labels[i], 520, "%s - %s", display, name);
+		else if (hasName || hasDisplay)
+			snprintf(labels[i], 520, "%s", hasName ? name : display);
+		else
+			snprintf(labels[i], 520, "Account %" PRIuz " (name unavailable)", i + 1);
+	}
+	ok = context->instance->ChooseFidoCredential(context->instance, (const char* const*)labels,
+	                                              count, selected) && *selected < count;
+out:
+	for (size_t i = 0; i < count; i++)
+		free(labels[i]);
+	free(labels);
+	return ok;
+}
