+/**
+ * Run one FIDO operation on a worker thread and ask for the PIN as the key needs
+ * it: a wrong PIN is asked for again with the retries left (up to
+ * RDPEWA_FIDO_PIN_ATTEMPTS prompts), and failed built-in user verification
+ * falls back to the PIN.
+ *
+ * @return the libfido2 result, FIDO_ERR_KEEPALIVE_CANCEL when the user dismissed
+ *         the PIN prompt, or RDPEWA_FIDO_ABORTED when the session is closing.
+ */
+static int rdpewa_fido_run(rdpContext* context, fido_dev_t* dev, RDPEWA_FIDO_ASYNC* fta,
+                           LPTHREAD_START_ROUTINE worker, bool uv, const char* site)
+{
+	WINPR_ASSERT(fta);
+
+	const bool useUv = uv && fido_dev_has_uv(dev);
+	bool needPin = fido_dev_has_pin(dev) && !useUv;
+	bool wrong = false;
+	int retries = -1;
+	size_t prompts = 0;
+
+	for (;;)
+	{
+		char* pin = nullptr;
+		if (needPin)
+		{
+			if (!rdpewa_fido_get_pin(context, site, wrong, retries, &pin))
+				return FIDO_ERR_KEEPALIVE_CANCEL;
+			prompts++;
+		}
+
+		fta->pin = pin;
+		fta->result = FIDO_ERR_INTERNAL;
+		HANDLE ft = CreateThread(nullptr, 0, worker, fta, 0, nullptr);
+		const bool finished = notifyWait(context, ft, dev);
+		fta->pin = nullptr;
+		winpr_zfree(pin);
+		if (!finished)
+			return RDPEWA_FIDO_ABORTED;
+
+		const int r = fta->result;
+		if (!needPin && useUv && rdpewa_fido_uv_failed(r) && fido_dev_has_pin(dev))
+		{
+			needPin = true;
+			continue;
+		}
+
+		if (needPin && (r == FIDO_ERR_PIN_INVALID) && (prompts < RDPEWA_FIDO_PIN_ATTEMPTS))
+		{
+			wrong = true;
+			if ((fido_dev_get_retry_count(dev, &retries) != FIDO_OK) || (retries < 0))
+				retries = -1;
+			if (retries == 0)
+				return FIDO_ERR_PIN_BLOCKED;
+			continue;
+		}
+		return r;
+	}
+}
