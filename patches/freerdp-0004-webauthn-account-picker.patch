+static const char* rdpewa_fido_error_text(int r)
+{
+	switch (r)
+	{
+		case FIDO_ERR_NO_CREDENTIALS:
+			return "This security key has no passkey for this site.";
+		case FIDO_ERR_PIN_INVALID:
+			return "Wrong security key PIN.";
+		case FIDO_ERR_PIN_BLOCKED:
+			return "The security key PIN is blocked. Reset the key to use it again.";
+		case FIDO_ERR_PIN_AUTH_BLOCKED:
+			return "Too many wrong PINs. Remove and reinsert the security key.";
+		case FIDO_ERR_PIN_NOT_SET:
+		case FIDO_ERR_PIN_REQUIRED:
+			return "Set a PIN on the security key first.";
+		case FIDO_ERR_UV_BLOCKED:
+		case FIDO_ERR_UV_INVALID:
+			return "The security key could not verify you.";
+		case FIDO_ERR_USER_ACTION_TIMEOUT:
+		case FIDO_ERR_ACTION_TIMEOUT:
+			return "The security key was not touched in time.";
+		case FIDO_ERR_CREDENTIAL_EXCLUDED:
+			return "This security key is already registered.";
+		case FIDO_ERR_OPERATION_DENIED:
+		case FIDO_ERR_NOT_ALLOWED:
+			return "The security key denied the request.";
+		default:
+			return "The security key request failed.";
+	}
+}
+
+/**
+ * Tell the user why a request failed. The message is
+ * "rdpewa-error:<libfido2 code>:<site>:<English text>" so a client can show its
+ * own wording; dismissing a prompt is not an error.
+ */
+static void rdpewa_fido_report(rdpContext* context, int r, const char* site)
+{
+	if ((r == FIDO_OK) || (r == FIDO_ERR_KEEPALIVE_CANCEL) || (r == RDPEWA_FIDO_ABORTED))
+		return;
+
+	char message[RDPEWA_FIDO_SITE_MAX + 128] = WINPR_C_ARRAY_INIT;
+	(void)_snprintf(message, sizeof(message), "rdpewa-error:%d:%s:%s", r, site ? site : "-",
+	                rdpewa_fido_error_text(r));
+
+	UserNotificationEventArgs e = WINPR_C_ARRAY_INIT;
+	EventArgsInit(&e, RDPEWA_CHANNEL_NAME);
+	e.message = message;
+	e.timeoutMS = 10000;
+	e.messageID = winpr_GetTickCount64NS();
+	if (PubSub_OnUserNotification(context->pubSub, context, &e) < 0)
+		WLog_WARN(TAG, "Could not report the security key failure to the client");
+}
+
+/**
+ * Answer a request that the authenticator (or the user) turned down. The RPC
+ * itself succeeded, so per [MS-RDPEWA] it returns S_OK with the CTAP status as
+ * the first response byte, which lets Windows explain the failure. Local
+ * failures without a CTAP status stay E_FAIL.
+ */
+static wStream* rdpewa_fido_error_response(int r, const RDPEWA_DEVICE_INFO* devInfo)
+{
+	if ((r > FIDO_OK) && (r <= UINT8_MAX))
+		return rdpewa_cbor_encode_webauthn_response(S_OK, (BYTE)r, nullptr, 0, devInfo);
+	return rdpewa_cbor_encode_webauthn_response(E_FAIL, 0x01, nullptr, 0, devInfo);
+}
